{
  "name": "koinos-node-manager",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "CLI-first fleet manager for Koinos nodes",
  "type": "module",
  "bin": {
    "knm": "./dist/cli/main.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
