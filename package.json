{
  "name": "koinos-node-manager",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "CLI-first fleet manager for Koinos nodes",
  "type": "module",
  "bin": {
    "knm": "./dist/cli/main.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build:identity": "node scripts/generate-build-identity.mjs",
    "build": "npm run --silent build:identity && tsc -p tsconfig.json",
    "check": "npm run --silent build:identity && tsc -p tsconfig.json --noEmit",
    "cli": "npm run --silent build:identity && tsx src/cli/main.ts",
    "test": "npm run --silent build:identity && tsx --test tests/**/*.test.ts",
    "test:compiled": "npm run --silent build && node scripts/test-compiled-cli.mjs",
    "verify": "npm run check && npm test && npm run test:compiled"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
